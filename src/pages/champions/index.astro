---
import dayjs from "dayjs";
import Layout from "../../layouts/Layout.astro";
import CurrentChampionsTable from "../_components/CurrentChampionsTable.svelte";
import { championsTable, columns } from "../_components/home";
import { getCurrentChampions } from "../../utils";
import OrgTags from "../../components/OrgTags.svelte";

const org = (abbreviation: string, short: string) => ({ abbreviation, short });

const rows = championsTable(await getCurrentChampions(), dayjs());
---

<Layout title="Current world champions" description="Current world boxing champions of the WBA, WBC, IBF, WBO and The Ring, at every weight class." img={null}>
	<section class="max-w-205 pt-[clamp(32px,6vw,56px)] pb-10">
		<h1 class="mb-4 font-heading text-[clamp(40px,7vw,56px)] leading-[1.08] font-semibold tracking-[-0.01em]">Current world champions</h1>
		<p class="font-serif text-[clamp(19px,3vw,22px)] leading-[1.45] text-ink-soft">
			The world champions of the <OrgTags orgs={[org("WBA", "WBA"), org("WBC", "WBC"), org("IBF", "IBF"), org("WBO", "WBO"), org("RING", "The Ring")]} /> at every weight class, and how long each has held the title. Gold marks an undisputed champion,
			holding the WBA, WBC, IBF and WBO titles at once.
		</p>
	</section>
	<CurrentChampionsTable orgs={columns} rows={rows} />
</Layout>
