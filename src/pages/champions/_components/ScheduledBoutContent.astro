---
import BoxerName from "../../../components/BoxerName.astro";
import dayjs from "dayjs";
import { orgColours } from "../../../utils";
import type { Bout } from "../../../types";

interface Props {
	bout: Bout;
}

const { bout } = Astro.props;
---

<p class="mb-1.5 text-right text-xs font-medium text-neutral-400">
	<time datetime={bout.date}>
		{dayjs(bout.date).format("ddd D MMM YYYY")}
	</time>
</p>

<p class="mb-1.5 h-8 truncate text-sm/4">
	<span class="inline-block"><BoxerName boxer={bout.boxers.boxerA} useShortName={true} useTwoLines={false} /></span> v <br />
	<span class="inline-block"><BoxerName boxer={bout.boxers.boxerB} useShortName={true} useTwoLines={false} /></span>
</p>

<ul class="flex h-4.5">
	{
		bout.titles.map((title) => (
			<li>
				<div title={`${title.weight.class} • ${title.org.name.short}`} class={`my-0.5 mr-1 size-3.5 rounded-full ${orgColours[title.org.name.abbreviation].bg}`} />
			</li>
		))
	}
</ul>
