---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { group } from "d3-array";
import { getAllTitles } from "../../db";
import { weightClasses, slugify } from "../../utils";

const titles = await getAllTitles();
const titlesByWeightClass = group(titles, (t) => t.weight.class);
---

<Layout title="Data" description="A collection of links where you can easily access all of the resources and information on Open Boxing." img={null}>
	<main>
		<Breadcrumbs route={[["Data", `${Astro.url.origin}/data/`]]} />

		<h1 class="my-8 text-3xl xl:mx-auto xl:max-w-240">Data</h1>

		<div class="xl:mx-auto xl:max-w-240">
			<p class="my-4">Below are links to the weight classes and titles we currently track.</p>
			<p class="my-4">
				All the data used by Open Boxing can be found on <a
					class="underline"
					href="https://github.com/edhwright/open-boxing/tree/main/data"
					target="_blank"
					rel="noreferrer">GitHub</a
				> as CSV files. We also offer an <a class="underline" href={`${Astro.url.origin}/api/`}>API</a> to explore this data.
			</p>
		</div>

		<div>
			{
				weightClasses.map((weightClass) => (
					<section class="border-b border-neutral-700 py-6 last:border-b-0 xl:mx-auto xl:max-w-240">
						<h2 class="mb-4 text-lg">
							<a class="hover:underline" href={`${Astro.url.origin}/${slugify(weightClass.class)}/`}>
								{weightClass.class}
							</a>
						</h2>
						<div>
							{titlesByWeightClass.get(weightClass.class)!.map((title) => (
								<p class="border-b border-neutral-700 bg-neutral-800 first:rounded-t last:rounded-b last:border-b-0 hover:bg-neutral-700 hover:underline">
									<a class="block w-full py-1 pl-4 text-sm leading-7" href={`${Astro.url.origin}/${slugify(weightClass.class)}/${slugify(title.org.name.abbreviation)}/`}>
										{title.org.name.full}
									</a>
								</p>
							))}
						</div>
					</section>
				))
			}
		</div>
	</main>
</Layout>