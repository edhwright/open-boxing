---
import Layout from "../../../layouts/Layout.astro";
import HeadToHead from "../_components/HeadToHead.svelte";

// An interactive: it runs in the browser, loading /data/interactives.json
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
---

<Layout title="Head to head" description="Compare the head to head records of selected world champions in world title bouts." img={null}>
	{/* the link above the heading sits in the top padding, so the heading lines up with other pages' */}
	<section class="pt-[max(16px,calc(clamp(32px,6vw,56px)-28px))] pb-8">
		<Breadcrumbs items={[{ name: "Data", href: "/data/" }]} current="Head to head" />
		<h1 class="mb-4 font-heading text-[clamp(40px,7vw,56px)] leading-[1.08] font-semibold tracking-[-0.01em]">Head to head</h1>
		<p class="max-w-205 font-serif text-[clamp(19px,3vw,22px)] leading-[1.45] text-ink-soft">Compare the head to head records of selected world champions in world title bouts.</p>
	</section>
	<HeadToHead client:only="svelte" />
	<noscript><p class="border-y border-rule py-12 text-center text-[15px] text-muted">This interactive needs JavaScript.</p></noscript>
</Layout>
