---
import dayjs from "dayjs";
import Layout from "../layouts/Layout.astro";
import CurrentChampionsTable from "./_components/CurrentChampionsTable.svelte";
import MonthList from "./_components/MonthList.svelte";
import { byMonth, championsTable, columns, titleChanges, upcomingBouts } from "./_components/home";
import OrgTags from "../components/OrgTags.svelte";
import { getAllBouts, getAllChampions, getAllReigns } from "../db/index";
import { getCurrentChampions } from "../utils";

const today = dayjs();
const [reigns, bouts, champions, currentChampions] = await Promise.all([getAllReigns(), getAllBouts(), getAllChampions(), getCurrentChampions()]);

const finishedBouts = bouts.filter((b) => b.status === "FINISHED");
const firstYear = dayjs(reigns.map((r) => r.period.begins).sort()[0]).year();
const count = (n: number) => n.toLocaleString("en-GB");

const rows = championsTable(currentChampions, today);
const org = (abbreviation: string, short: string) => ({ abbreviation, short });

const upcoming = byMonth(upcomingBouts(bouts));
const changes = byMonth(titleChanges(reigns, bouts, today.subtract(12, "month").format("YYYY-MM-DD")));
---

<Layout title="Open Boxing" description="Open source world championship boxing data, plus an archive of public domain newspaper articles and documents." img={null}>
	<section class="max-w-205 pt-[clamp(32px,6vw,56px)] pb-10">
		<h1 class="mb-4 font-heading text-[clamp(40px,7vw,56px)] leading-[1.08] font-semibold tracking-[-0.01em]">Open Boxing</h1>
		<p class="mb-4 font-serif text-[clamp(19px,3vw,22px)] leading-[1.45] text-ink-soft">Open source world championship boxing data, plus an archive of public domain newspaper and magazine articles.</p>
		<p class="mb-4 font-serif text-[clamp(19px,3vw,22px)] leading-[1.45] text-ink-soft">
			The data covers the world titles of the{" "}
			<OrgTags
				orgs={[org("IBU", "IBU"), org("NYSAC", "NYSAC"), org("WBA", "WBA"), org("WBC", "WBC"), org("IBF", "IBF"), org("WBO", "WBO"), org("RING", "The Ring")]}
			/>.
		</p>
		<p class="font-serif text-[clamp(19px,3vw,22px)] leading-[1.45] text-ink-soft">
			Since {firstYear}, there have been {count(finishedBouts.length)} world title bouts, {count(champions.length)} world champions and {count(reigns.length)} reigns.
		</p>
		<p class="mt-4 font-serif text-[clamp(19px,3vw,22px)] leading-[1.45] text-ink-soft">
			Open Boxing is a work in progress. Found a mistake? Raise an issue on{" "}
			<a href="https://github.com/edhwright/open-boxing/issues" class="text-ink underline decoration-gold decoration-2 underline-offset-4">GitHub</a>.
		</p>
	</section>

	<section aria-labelledby="champions" class="mb-18">
		<h2 id="champions" class="border-b-2 border-ink pb-2.5 font-heading text-[28px] leading-8 font-semibold">
			<a href="/champions/">Current world champions</a>
		</h2>
		<CurrentChampionsTable orgs={columns} rows={rows} />
	</section>

	<section aria-labelledby="upcoming" class="mb-18">
		<h2 id="upcoming" class="border-b-2 border-ink pb-2.5 font-heading text-[28px] leading-8 font-semibold">Upcoming world title bouts</h2>
		<MonthList months={upcoming} empty="No world title bouts are scheduled." />
	</section>

	<section aria-labelledby="changes">
		<h2 id="changes" class="border-b-2 border-ink pb-2.5 font-heading text-[28px] leading-8 font-semibold">World title changes</h2>
		<MonthList months={changes} empty="No world title changes in the last 12 months." />
	</section>
</Layout>
