---
import Layout from "../layouts/Layout.astro";
import LatestChampions from "./_components/LatestChampions.astro";
import CurrentChampions from "./_components/CurrentChampions.astro";
import ScheduledBouts from "./_components/ScheduledBouts.astro";
import { getScheduledBouts, getLatestReigns } from "../db/index";
import { getCurrentChampions } from "../utils";

const currentChampions = await getCurrentChampions();
const latestReigns = await getLatestReigns(10);
const scheduledBouts = await getScheduledBouts();
---

<Layout title="Open Boxing" description="Open source world championship boxing data and articles." img={null}>
	<main>
		<header class="mt-12 mb-4 mx-0">
			<h1 class="text-4xl mb-2 text-center">Open Boxing</h1>
			<p class="max-w-md mx-auto text-center text-gray-500">World championship boxing data and articles</p>
		</header>
		<div class="grid gap-4 xl:grid-cols-4">
			<section class="border-b border-neutral-700 pb-4 xl:col-span-4">
				<h2 class="text-2xl mb-3">Recently won titles</h2>
				<LatestChampions latestReigns={latestReigns} />
			</section>
			<section class="border-b border-neutral-700 pb-4 xl:col-span-3 xl:border-b-0 xl:pb-0">
				<h2 class="text-2xl mb-3">
					<a class="hover:underline" href={`${Astro.url.origin}/champions/`}>Current world champions</a>
				</h2>
				<CurrentChampions currentChampions={currentChampions} />
			</section>
			<section class="xl:border-l xl:border-neutral-700 xl:pl-4">
				<h2 class="text-2xl mb-3">
					<a class="hover:underline" href={`${Astro.url.origin}/scheduled-bouts/`}>Scheduled world title bouts</a>
				</h2>
				<ScheduledBouts scheduledBouts={scheduledBouts} />
			</section>
		</div>
	</main>
</Layout>