---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Page Not Found" description="Page not found!" img={null}>
	<main class="xl:mx-auto xl:max-w-240">
		<header class="my-8">
			<h1 class="text-3xl">Sorry, the page you requested was not found</h1>
		</header>

		<iframe
			class="max-w-full border-0"
			width="560"
			height="315"
			src="https://www.youtube-nocookie.com/embed/pWIqZKhNY90"
			title="YouTube video player"
			allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
			allowfullscreen></iframe>
	</main>
</Layout>