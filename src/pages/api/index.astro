---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Docs from "./_components/Docs.md";
---

<Layout title="API" description="Open Boxing API." img={null}>
	<main>
		<Breadcrumbs route={[["API", `${Astro.url.origin}/api/`]]} />

		<h1 class="my-8 text-3xl xl:mx-auto xl:max-w-240">API</h1>

		<div class="xl:mx-auto xl:max-w-240">
			<p class="my-4">
				We provide a basic API to explore our data. Open Boxing is in very early development, so expect some mistakes and missing data. Found a bug or mistake? Please raise an
				issue on <a class="underline" href="https://github.com/edhwright/open-boxing/issues" target="_blank" rel="noreferrer">GitHub</a>.
			</p>
		</div>

		<div
			class="prose max-w-none prose-invert prose-h2:mt-6 prose-h2:mb-4 prose-h2:text-lg prose-h3:mt-6 prose-h3:mb-4 prose-h3:text-sm prose-p:my-4 prose-code:before:content-none prose-code:after:content-none prose-pre:rounded prose-pre:p-4 prose-pre:text-sm prose-hr:my-6 prose-hr:border-neutral-700 xl:mx-auto xl:max-w-240 [&_p>code]:mb-1 [&_p>code]:inline-block [&_p>code]:rounded [&_p>code]:bg-neutral-700 [&_p>code]:p-1.5 [&_p>code]:text-sm [&_p>code]:font-normal"
		>
			<hr />
			<Docs />
		</div>
	</main>
</Layout>