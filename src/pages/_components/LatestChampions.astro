---
import ChampionContent from "../../components/ChampionContent.astro";
import type { Reign } from "../../types";

interface Props {
	latestReigns: Reign[];
}

const { latestReigns } = Astro.props;

// show as many as fill whole rows: 8 on small screens, 9 on medium, 6 on large, 8 on extra large
const visibility = (i: number) => (i < 6 ? "" : i < 8 ? "lg:hidden xl:block" : i < 9 ? "hidden md:block lg:hidden" : "hidden");
---

<div class="grid grid-cols-12 gap-4 xl:grid-cols-16">
	{
		latestReigns.map((reign, i) => (
			<div class={`col-span-6 overflow-hidden rounded border border-neutral-700 bg-neutral-800 p-3 md:col-span-4 lg:col-span-2 ${visibility(i)}`}>
				<ChampionContent reign={reign} dateFormat="D MMM YYYY" includeWeightClass={true} isUndisputed={false} />
			</div>
		))
	}
</div>
