---
import ChampionContent from "../../components/ChampionContent.astro";
import { slugify } from "../../utils";
import type { WeightClassCurrentChampions } from "../../utils";
import type { Reign } from "../../types";

interface Props {
	currentChampions: WeightClassCurrentChampions[];
}

const { currentChampions } = Astro.props;

const useUndisputedClass = (reign: Reign | null, undisputed: boolean) => reign && undisputed && ["WBAS", "WBC", "IBF", "WBO"].includes(reign.title.org.name.abbreviation);

// on large screens, extend the gold across the gap to the next undisputed card
const joinsNextCard = (reign: Reign | null) => reign && ["WBAS", "WBC", "IBF"].includes(reign.title.org.name.abbreviation);
---

{
	currentChampions.map((weightClassChampions) => (
		<section class="mb-4 grid grid-cols-12 gap-4 border-b border-neutral-700 pb-4 last:mb-0 last:border-b-0 last:pb-0">
			<h3 class="col-span-12 lg:col-span-2">
				<a class="flex w-max items-baseline justify-between hover:underline lg:flex-col" href={`${Astro.url.origin}/${slugify(weightClassChampions.weight.class)}/`}>
					<span class="text-sm/4 font-semibold after:whitespace-pre after:content-['_'] lg:after:content-none">{weightClassChampions.weight.class}</span>
					<span class="text-xs/4 font-medium text-neutral-400">{weightClassChampions.weight.lb} lb</span>
				</a>
			</h3>

			{weightClassChampions.champions.map((reign) => (
				<div
					class={`col-span-6 overflow-hidden rounded border p-3 md:col-span-4 lg:col-span-2 lg:first-of-type:hidden ${
						useUndisputedClass(reign, weightClassChampions.undisputed)
							? `border-gold bg-gold ${joinsNextCard(reign) ? "lg:shadow-[calc(1rem+6px)_0_0_0_var(--color-gold)]" : ""}`
							: "border-neutral-700 bg-neutral-800"
					}`}
				>
					<ChampionContent reign={reign} dateFormat="D MMM YYYY -" includeWeightClass={false} isUndisputed={weightClassChampions.undisputed} />
				</div>
			))}
		</section>
	))
}
