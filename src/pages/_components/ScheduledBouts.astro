---
import BoutContent from "../../components/BoutContent.astro";
import type { Bout } from "../../types";

interface Props {
	scheduledBouts: Bout[];
}

const { scheduledBouts } = Astro.props;
---

<div class="grid grid-cols-12 gap-4">
	{
		scheduledBouts.map((bout, i) => (
			<div class={`col-span-12 rounded border border-neutral-700 bg-neutral-800 p-3 md:col-span-6 lg:col-span-4 xl:col-span-12 ${i >= 12 ? "xl:hidden" : ""}`}>
				<BoutContent bout={bout} dateFormat="ddd D MMM YYYY" includeWeightClass={true} useShortName={false} />
			</div>
		))
	}
</div>
