---
import TimelineEvents from "../../../components/TimelineEvents.astro";
import TimelineReferences from "../../../components/TimelineReferences.astro";
import dayjs from "dayjs";
import type { TimelineDate } from "../../../utils";

interface Props {
	timeline: TimelineDate[];
	target: "WEIGHT" | "ORG";
	boutArticleIds: number[];
}

const { timeline, target, boutArticleIds } = Astro.props;

const firstEventOfDecades: [string, TimelineDate][] = [...new Set(timeline.map((timelineDate) => `${dayjs(timelineDate.date).format("YYYY").slice(0, -1)}0`))].map((decade) => [
	decade,
	timeline.find((timelineDate) => decade === `${dayjs(timelineDate.date).format("YYYY").slice(0, -1)}0`) as TimelineDate,
]);

const shouldBreakTimeline = (index: number, previousTimelineDate: TimelineDate): boolean => {
	if (target !== "ORG") {
		return false;
	} else if (index === 0) {
		return false;
	} else if (previousTimelineDate.events.titleReignsEnd !== null && previousTimelineDate.events.titleReignsBegin === null) {
		return true;
	} else {
		return false;
	}
};

// a break (a vacant title) splits the timeline into separate rounded boxes
const itemClass = (i: number) => {
	const breaksBefore = shouldBreakTimeline(i, timeline[i - 1]);
	const breaksAfter = i < timeline.length - 1 && shouldBreakTimeline(i + 1, timeline[i]);
	return `flex w-full border-x border-b border-neutral-700 bg-neutral-800 first:rounded-t first:border-t last:rounded-b lg:grid lg:grid-cols-6 ${breaksBefore ? "mt-4 rounded-t border-t" : ""} ${breaksAfter ? "rounded-b" : ""}`;
};
---

<!-- on small screens the second, zero-width column holds the sticky "Back to top" button -->
<div class="grid grid-cols-[auto_0px] grid-rows-[auto_auto] gap-y-4 xl:grid-cols-16 xl:grid-rows-none xl:gap-4">
	<nav class="col-start-1 row-start-1 py-3 xl:sticky xl:top-0 xl:col-span-2 xl:col-start-auto xl:max-h-screen xl:self-start xl:overflow-y-auto">
		<h3 class="text-sm/4 font-semibold">Decades</h3>
		<ol>
			{
				firstEventOfDecades.map(([decade, timelineDate]) => (
					<li class="my-3 text-sm/4">
						<a class="hover:underline" href={`#${timelineDate.date}`}>
							{decade}s
						</a>
					</li>
				))
			}
		</ol>
		{
			timeline.length > 20 && (
				<p class="hidden text-sm/4 xl:block">
					<a class="hover:underline" href="#timeline">
						Back to top
					</a>
				</p>
			)
		}
	</nav>
	<ol class="col-start-1 row-start-2 xl:col-span-12 xl:col-start-auto xl:row-start-auto">
		{
			timeline.map((timelineDate, i) => (
				<li class={itemClass(i)} id={timelineDate.date}>
					<p class="group flex w-1/5 justify-end pt-3 pr-4 pb-2 text-right text-xs/4 font-medium text-neutral-400 [word-spacing:100vw] md:[word-spacing:normal] lg:col-span-1 lg:w-auto lg:pb-0">
						<a href={`#${timelineDate.date}`} class="relative -top-0.5 mr-1 hidden size-5 lg:group-hover:inline">
							<img class="invert" src={`${Astro.url.origin}/icons/link.svg`} />
						</a>
						{dayjs(timelineDate.date).format("D MMM YYYY")}
					</p>
					<div class="w-4/5 lg:col-span-3 lg:w-auto">
						<TimelineEvents timelineDate={timelineDate} />
					</div>
					<ul class="hidden px-4 py-3 lg:col-span-2 lg:block">
						<TimelineReferences timelineDate={timelineDate} boutArticleIds={boutArticleIds} />
					</ul>
				</li>
			))
		}
	</ol>
	<div class="sticky bottom-5 col-start-2 row-start-2 mt-[calc(100vh+100px)] place-self-end rounded bg-neutral-950 p-3 text-sm/4 whitespace-nowrap xl:hidden">
		<p><a class="hover:underline" href="#timeline">Back to top</a></p>
	</div>
</div>
