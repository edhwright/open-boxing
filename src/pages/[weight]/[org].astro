---
import dayjs from "dayjs";
import { getCollection } from "astro:content";
import WeightTitlePage from "./_components/WeightTitlePage.astro";
import { pageBouts, pageReigns } from "./_components/weight";
import { getAllTitles, getTitleBouts, getTitleReigns } from "../../db";
import { getAllFeaturedBoutPreviews, filterFeaturedBoutPreviewsByTitle, slugify } from "../../utils";

// A page per world title. The WBA Super world title carries on the WBA world title (the NBA's before it), so it has
// no page of its own: the WBA page holds both, with their reigns and bouts still marked as WBA or WBA Super. The WBA
// Regular world title, the WBA's secondary title, keeps its own page
export async function getStaticPaths() {
	const titles = await getAllTitles();
	const allFeaturedBoutPreviews = await getAllFeaturedBoutPreviews();
	const articleCounts: Record<number, number> = {};
	for (const article of await getCollection("bouts")) articleCounts[article.data.boutId] = (articleCounts[article.data.boutId] ?? 0) + 1;
	const hasTitle = (weightClass: string, org: string) => titles.some((t) => t.weight.class === weightClass && t.org.name.abbreviation === org);

	return Promise.all(
		titles
			.filter((title) => !(title.org.name.abbreviation === "WBAS" && hasTitle(title.weight.class, "WBA")))
			.map(async (title) => {
				const weightClass = title.weight.class;
				const org = title.org.name.abbreviation;
				const orgs = org === "WBA" && hasTitle(weightClass, "WBAS") ? ["WBA", "WBAS"] : [org];
				const reigns = (await Promise.all(orgs.map((o) => getTitleReigns(weightClass, o)))).flat().sort((a, b) => a.period.begins.localeCompare(b.period.begins));
				// a bout for both titles is listed once
				const bouts = [...new Map((await Promise.all(orgs.map((o) => getTitleBouts(weightClass, o)))).flat().map((b) => [b.boutId, b])).values()].sort((a, b) =>
					a.date.localeCompare(b.date),
				);
				const previews = [...new Map(orgs.flatMap((o) => filterFeaturedBoutPreviewsByTitle(allFeaturedBoutPreviews, weightClass, o)).map((p) => [p.bout.boutId, p])).values()];
				return {
					params: { weight: slugify(weightClass), org: slugify(org) },
					props: {
						title,
						// still contested, as either title
						active: titles.some((t) => t.weight.class === weightClass && orgs.includes(t.org.name.abbreviation) && t.active),
						titles,
						reigns,
						bouts,
						archive: previews
							.sort((a, b) => a.bout.date.localeCompare(b.bout.date))
							.map((p) => ({
								href: `/articles/${p.bout.date}-${slugify(p.name)}/`,
								img: p.thumbnail,
								name: p.name,
								date: p.bout.date,
								count: articleCounts[p.bout.boutId] ?? 0,
							})),
					},
				};
			}),
	);
}

const { title, active, titles, reigns, bouts, archive } = Astro.props;
const today = dayjs().format("YYYY-MM-DD");
const org = { abbreviation: title.org.name.abbreviation, short: title.org.name.short };
const boutData = pageBouts(bouts, title.weight.class);
const reignData = pageReigns(reigns, boutData, today);
---

<WeightTitlePage
	weightClass={title.weight.class}
	lb={title.weight.lb}
	org={org}
	active={active}
	titles={titles}
	reigns={reignData}
	bouts={boutData}
	undisputedNow={[]}
	archive={archive}
	today={today}
/>
