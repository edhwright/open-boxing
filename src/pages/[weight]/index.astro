---
import dayjs from "dayjs";
import { getCollection } from "astro:content";
import WeightTitlePage from "./_components/WeightTitlePage.astro";
import { pageBouts, pageReigns } from "./_components/weight";
import { getAllTitles, getWeightClassBouts, getWeightClassReigns } from "../../db";
import { getAllFeaturedBoutPreviews, filterFeaturedBoutPreviewsByWeightClass, slugify, weightClasses } from "../../utils";
import { undisputedNow } from "../../undisputed";

export async function getStaticPaths() {
	const titles = await getAllTitles();
	const allFeaturedBoutPreviews = await getAllFeaturedBoutPreviews();
	const articleCounts: Record<number, number> = {};
	for (const article of await getCollection("bouts")) articleCounts[article.data.boutId] = (articleCounts[article.data.boutId] ?? 0) + 1;

	return Promise.all(
		[...new Set(titles.map((t) => t.weight.class))].map(async (weightClass) => ({
			params: { weight: slugify(weightClass) },
			props: {
				weightClass,
				titles,
				reigns: await getWeightClassReigns(weightClass),
				bouts: await getWeightClassBouts(weightClass),
				archive: filterFeaturedBoutPreviewsByWeightClass(allFeaturedBoutPreviews, weightClass).map((p) => ({
					href: `/articles/${p.bout.date}-${slugify(p.name)}/`,
					img: p.thumbnail,
					name: p.name,
					date: p.bout.date,
					count: articleCounts[p.bout.boutId] ?? 0,
				})),
			},
		})),
	);
}

const { weightClass, titles, reigns, bouts, archive } = Astro.props;
const today = dayjs().format("YYYY-MM-DD");
const boutData = pageBouts(bouts, weightClass);
const reignData = pageReigns(reigns, boutData, today);
const lb = weightClasses.find((wc) => wc.class === weightClass)?.lb ?? "";
---

<WeightTitlePage
	weightClass={weightClass}
	lb={lb}
	org={null}
	active={true}
	titles={titles}
	reigns={reignData}
	bouts={boutData}
	undisputedNow={undisputedNow(weightClass)}
	archive={archive}
	today={today}
/>
