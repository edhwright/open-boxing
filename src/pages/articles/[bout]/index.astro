---
import dayjs from "dayjs";
import { boutNameFromBout, slugify } from "../../../utils";
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Reference from "./_components/Reference.astro";
import LocationGlobe from "../../../components/LocationGlobe.svelte";
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getBout } from "../../../db";
import { group } from "d3-array";
import type { Bout } from "../../../types";

interface Props {
	boutName: string;
	thumbnail: string | undefined;
	bout: Bout;
	articles: CollectionEntry<"bouts">[];
}

export async function getStaticPaths() {
	const boutArticles = await getCollection("bouts");
	const articlesByBout = group(boutArticles, (a) => a.data.boutId);

	return await Promise.all(
		[...articlesByBout].map(async ([boutId, articles]) => {
			const bout = await getBout(boutId);
			return {
				params: {
					bout: `${bout.date}-${slugify(boutNameFromBout(bout))}`,
				},
				props: {
					boutName: boutNameFromBout(bout),
					thumbnail: articles[0].data.thumbnail,
					bout: bout,
					articles: articles.sort((a, b) => a.data.publicationDate.localeCompare(b.data.publicationDate)),
				},
			};
		}),
	);
}

const { boutName, thumbnail, bout, articles } = Astro.props;

const { location } = bout;
const place = [location.venue, location.locality, location.country].filter(Boolean).join(", ");

const articleComponents = await Promise.all(
	articles.map(async (a) => {
		const { Content, headings } = await render(a);
		return { Content, headingSlug: headings[0].slug, data: a.data };
	})
);
---

<Layout
	title={boutName}
	description={`Public domain ${boutName} articles.`}
	img={thumbnail ? { url: thumbnail, width: "1280", height: "720", alt: `${boutName} thumbnail` } : null}
>
	<main>
		<Breadcrumbs
			route={[
				["Articles", `${Astro.url.origin}/articles/`],
				[boutName, `${Astro.url.origin}/articles/${bout.boutId}/`],
			]}
		/>

		<header class="my-8">
			<h1 class="mx-auto mt-12 mb-4 text-center text-4xl">{boutName}</h1>
			<div class="text-center text-sm">
				<p class="mb-2">
					<time datetime={dayjs(bout.date).format("YYYY-MM-DD")}>
						{dayjs(bout.date).format("dddd, D MMMM, YYYY")}
					</time>
				</p>
				{
					place &&
						(location.latitude !== null && location.longitude !== null ? (
							<div class="mb-2 flex items-center justify-center gap-3">
								<LocationGlobe latitude={location.latitude} longitude={location.longitude} label={place} />
								<p>{place}</p>
							</div>
						) : (
							<p class="mb-2">{place}</p>
						))
				}
				<p class="mb-2">{bout.weight.class} ({bout.weight.lb} lb)</p>
				<div>
					{
						bout.titles.map((title) => (
							<p>
								{title.org.name.full} {title.weight.class} title
							</p>
						))
					}
				</div>
			</div>
		</header>

		<!-- on small screens the second, zero-width column holds the sticky "Back to top" button -->
		<div id="articles" class="grid grid-cols-[auto_0px] grid-rows-[auto_auto] gap-y-4 lg:grid-cols-16 lg:grid-rows-none lg:gap-4">
			<nav class="col-start-1 row-start-1 py-3 md:mx-auto md:w-3/4 lg:sticky lg:top-0 lg:col-span-4 lg:col-start-auto lg:mx-0 lg:max-h-screen lg:w-auto lg:self-start lg:overflow-y-auto xl:max-w-3/4">
				<h3 class="text-sm font-semibold">Articles</h3>
				<ul>
					{
						articleComponents.map((article) => (
							<li class="my-3 text-sm">
								<a class="hover:underline" href={`#${article.headingSlug}`}>
									{article.data.title}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<ul class="col-start-1 row-start-2 lg:col-span-12 lg:col-start-auto lg:row-start-auto">
				{
					articleComponents.map(({ Content, data }) => (
						<li class="border-t-4 border-neutral-100 pt-3 pb-8 md:mx-auto md:w-3/4 lg:mx-0 lg:w-5/6 xl:w-2/3">
							<div>
								<Reference bout={bout} author={data.author} publication={data.publication} publicationDate={data.publicationDate} link={{ text: "Source", url: data.link }} />
							</div>
							<section class="prose max-w-none prose-invert prose-h2:mt-12 prose-h2:mb-4 prose-h2:text-3xl prose-h3:mt-12 prose-h3:mb-4 prose-h3:text-xl prose-h3:font-semibold prose-h4:mt-12 prose-h4:mb-4 prose-h4:text-lg prose-h4:font-semibold prose-p:mt-0 prose-p:mb-4 prose-p:font-serif prose-p:text-lg prose-hr:my-2 prose-hr:border-neutral-700 prose-img:mx-auto prose-img:mt-6 prose-img:mb-4">
								<Content />
							</section>
						</li>
					))
				}
			</ul>

			<div class="sticky bottom-5 col-start-2 row-start-2 mt-[calc(100vh+100px)] place-self-end rounded bg-neutral-950 p-3 text-sm whitespace-nowrap lg:hidden"><p><a class="hover:underline" href="#articles">Back to top</a></p></div>
		</div>
	</main>
</Layout>