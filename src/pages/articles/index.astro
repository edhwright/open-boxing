---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getAllFeaturedBoutPreviews, slugify } from "../../utils";
import { fullDate } from "../../dates";
import BladeIssues from "./_components/BladeIssues.astro";

const bouts = await getAllFeaturedBoutPreviews();
// the featured bouts' articles (a bout's articles are featured together, with a thumbnail)
const boutArticles = await getCollection("bouts", ({ data }) => data.featured);
// how many articles each bout has
const forBout = (boutId: number) => boutArticles.filter((a) => a.data.boutId === boutId);
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
---

<Layout
	tone="paper"
	title="Articles"
	description="Public domain newspaper and magazine articles."
	img={null}
>
	<section class="pt-[clamp(32px,6vw,56px)] pb-10">
		<h1 class="mb-4 font-heading text-[clamp(40px,7vw,56px)] leading-[1.08] font-semibold tracking-[-0.01em]">Articles</h1>
		<p class="max-w-205 font-serif text-[clamp(19px,3vw,22px)] leading-[1.45] text-ink-soft">
			Public domain newspaper and magazine articles.
		</p>
	</section>

	<section aria-labelledby="bouts" class="mb-18">
		<h2 id="bouts" class="border-b-2 border-ink pb-2.5 font-heading text-[28px] leading-8 font-semibold">Bouts</h2>
		<ul class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-8 pt-6">
			{
				bouts.map((b) => {
					const articles = forBout(b.bout.boutId);
					return (
						<li>
							<a href={`/articles/${b.bout.date}-${slugify(b.name)}/`} class="group block hover:no-underline">
								{b.thumbnail && <Image src={b.thumbnail} alt={b.name} widths={[480, 960]} sizes="(max-width: 760px) calc(100vw - 32px), 440px" class="block aspect-video h-auto w-full border border-ink object-cover grayscale" />}
								<p class="mt-3 mb-0.5 text-[13px] text-muted">
									{fullDate(b.bout.date)} · {b.bout.weight.class}
								</p>
								<p class="font-serif text-[22px] leading-7 font-semibold group-hover:underline">{b.name}</p>
								<p class="mt-1 text-sm underline decoration-gold decoration-2 underline-offset-4">
									Read {plural(articles.length, "article")}
								</p>
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>

	<section aria-labelledby="blade" class="mb-18">
		<h2 id="blade" class="border-b-2 border-ink pb-2.5 font-heading text-[28px] leading-8 font-semibold">
			<a href="/articles/the-boxing-blade/">The Boxing Blade</a>
		</h2>
		<p class="mt-4 max-w-205 font-serif text-xl leading-normal text-ink-soft">
			An archive of <em>The Boxing Blade</em>, a weekly boxing publication that ran from 1919 to 1926.
		</p>
		<BladeIssues />
	</section>
</Layout>
