---
import { Image, getImage } from "astro:assets";
import { render } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import ArticleNav from "../../../../components/ArticleNav.astro";
import { fullDate, weekdayDate } from "../../../../dates";
import { getBladeIssues } from "../../_components/blade";

// An issue of The Boxing Blade: its front page and details on a maroon band, then its transcribed articles
export async function getStaticPaths() {
	const issues = await getBladeIssues();
	return issues.map((entry, i) => ({
		params: { issue: `volume-${entry.issue.data.volume}-number-${entry.issue.data.number}` },
		props: { entry, previous: issues[i - 1] ?? null, next: issues[i + 1] ?? null },
	}));
}

const { entry, previous, next } = Astro.props;
const { issue, articles } = entry;
const data = issue.data;
const date = fullDate(data.publicationDate);
const pages = (p: number[]) => (p.length === 1 ? `Page ${p[0]}` : `Pages ${p[0]}–${p.at(-1)}`);
const slug = (s: string) =>
	s
		.toLowerCase()
		.replace(/[^a-z0-9 ]/g, "")
		.trim()
		.replaceAll(" ", "-");
const rendered = await Promise.all(
	articles.map(async (a) => {
		const { Content } = await render(a);
		// the headline the article opens with, which the Markdown plugin drops from the article itself
		const title = a.body?.match(/^#{1,2}\s+(.+)$/m)?.[1].trim() ?? a.id;
		return { Content, data: a.data, title, id: slug(title) };
	}),
);
// for search engines: each transcribed article as a NewsArticle, at its place on this page, in this issue of the
// paper, based on the scan at the New York Public Library
const page = new URL(Astro.url.pathname, Astro.site);
const cover = await getImage({ src: data.cover, width: 1200 });
const issueLd = {
	"@type": "PublicationIssue",
	issueNumber: data.number,
	datePublished: data.publicationDate,
	isPartOf: { "@type": "PublicationVolume", volumeNumber: data.volume, isPartOf: { "@type": "Periodical", name: data.publication } },
};
const jsonLd = rendered.map((a) => ({
	"@context": "https://schema.org",
	"@type": "NewsArticle",
	headline: a.title,
	datePublished: a.data.publicationDate,
	url: `${page.href}#${a.id}`,
	mainEntityOfPage: page.href,
	author: a.data.author ? { "@type": "Person", name: a.data.author } : { "@type": "Organization", name: data.publication },
	publisher: { "@type": "Organization", name: data.publication },
	image: new URL(cover.src, Astro.site).href,
	isBasedOn: a.data.link,
	isPartOf: issueLd,
	pageStart: a.data.pages[0],
	isAccessibleForFree: true,
}));
const details = [
	["Published", data.place],
	["Edition", data.edition],
	["Pages", String(data.pages)],
];
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
---

<Layout tone="paper" jsonLd={jsonLd} title={`The Boxing Blade, ${date}`} description={`Volume ${data.volume}, number ${data.number} of The Boxing Blade, ${date}: its articles, transcribed.`} img={null}>
	{/* the band runs the full width of the screen, above the page's column */}
	<section slot="band" aria-labelledby="issue-title" class="bg-blade-band text-blade-band-ink">
		<div class="mx-auto max-w-340 px-[clamp(16px,4vw,24px)] pt-[clamp(24px,5vw,48px)] pb-[clamp(28px,5vw,48px)]">
			<Breadcrumbs
				items={[
					{ name: "Articles", href: "/articles/" },
					{ name: "The Boxing Blade", href: "/articles/the-boxing-blade/" },
				]}
				current={`Volume ${data.volume}, number ${data.number}`}
				linkClass="text-blade-band-ink"
				mutedClass="text-blade-band-muted"
				class="mb-6"
			/>
			<div class="grid grid-cols-[300px_minmax(0,1fr)] items-start gap-14 max-[760px]:grid-cols-1 max-[760px]:gap-8">
				<a href={data.link} target="_blank" rel="noreferrer" class="block w-full max-[760px]:max-w-60" aria-label={`Front page of The Boxing Blade, ${date}, at the New York Public Library`}>
					<Image src={data.cover} alt={`Front page of The Boxing Blade, ${date}`} width={600} loading="eager" class="block h-auto w-full border border-blade-band-ink" />
				</a>
				<div class="min-w-0">
					<p class="mb-2 font-serif text-[22px] leading-[1.3] italic">The Boxing Blade</p>
					<h1 id="issue-title" class="mb-2 font-display text-[clamp(40px,7vw,64px)] leading-[1.05] tracking-[-0.01em]">
						Volume {data.volume}, Number {data.number}
					</h1>
					<p class="mb-7 font-serif text-[clamp(20px,3vw,26px)] leading-[1.3]">{weekdayDate(data.publicationDate)}</p>
					<dl class="mb-7 grid max-w-180 grid-cols-[repeat(auto-fit,minmax(140px,1fr))] gap-x-6 gap-y-4 border-y border-blade-band-muted py-4">
						{
							details.map(([label, value]) => (
								<div class="flex flex-col gap-0.5">
									<dt class="text-xs text-blade-band-muted">{label}</dt>
									<dd class="text-[15px]">{value}</dd>
								</div>
							))
						}
					</dl>
					<p class="mb-6 max-w-160 font-serif text-[19px] leading-normal">
						{rendered.length} articles from this issue are transcribed below.
					</p>
					<a href={data.link} target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center gap-2.5 border border-blade-band-ink px-4 py-2.5 text-[15px] leading-5 font-medium">
						View the scans in the New York Public Library's Digital Collections
						<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg>
					</a>
					<nav aria-label="Other issues" class="mt-8 grid max-w-180 grid-cols-2 gap-4 border-t border-blade-band-muted pt-4">
						{
							previous ? (
								<a href={previous.href} class="flex min-h-11 flex-col justify-center">
									<span class="text-[13px] text-blade-band-muted">← Previous issue</span>
									<span class="text-[15px] font-medium">
										{fullDate(previous.issue.data.publicationDate)}, number {previous.issue.data.number}
									</span>
								</a>
							) : (
								<span />
							)
						}
						{
							next && (
								<a href={next.href} class="flex min-h-11 flex-col items-end justify-center text-right">
									<span class="text-[13px] text-blade-band-muted">Next issue →</span>
									<span class="text-[15px] font-medium">
										{fullDate(next.issue.data.publicationDate)}, number {next.issue.data.number}
									</span>
								</a>
							)
						}
					</nav>
				</div>
			</div>
		</div>
	</section>

	<div class="grid grid-cols-[300px_minmax(0,1fr)] items-start gap-16 max-[1000px]:grid-cols-1 max-[1000px]:gap-0">
		<nav aria-label="In this issue" data-article-nav class="sticky top-6 max-h-[calc(100vh-48px)] overflow-y-auto pt-10 max-[1000px]:static max-[1000px]:max-h-none max-[1000px]:pb-6">
			<h2 class="mb-1 text-[15px] leading-5 font-semibold">In this issue</h2>
			<ol>
				{
					rendered.map((a) => (
						<li class="border-b border-rule last:border-b-0">
							{/* the whole row is the link; the title underlines and the row darkens on hover */}
							<a href={`#${a.id}`} class="group flex gap-3 py-2 pr-2 hover:bg-ink/5 hover:no-underline">
								<span class="w-[2.2em] shrink-0 text-xs leading-[19px] tabular-nums text-muted">p{a.data.pages[0]}</span>
								<span class="text-sm leading-[19px] font-medium group-hover:underline">{a.title}</span>
							</a>
						</li>
					))
				}
			</ol>
		</nav>
		<div class="min-w-0">
			{
				rendered.map(({ Content, data: article, title, id }) => (
					<article id={id} class="scroll-mt-6 border-t-2 border-ink pt-10 pb-12 first:border-t-0">
						<p class="mb-3 flex flex-wrap gap-x-3 gap-y-1 text-[13px] leading-5 text-muted">
							<span>{pages(article.pages)}</span>
							{article.author && <span>By {article.author}</span>}
						</p>
						<h2 class="mb-7 max-w-[24ch] font-display text-4xl leading-[1.15]">{title}</h2>
						<div class="article-prose">
							<Content />
						</div>
					</article>
				))
			}
		</div>
	</div>
	<ArticleNav />
</Layout>
