---
import { Image } from "astro:assets";
import dayjs from "dayjs";
import { fullDate } from "../../../dates";
import { getBladeIssues } from "./blade";

// The Boxing Blade's issues by year: front page, volume and number, date, and how many articles are transcribed
const issues = await getBladeIssues();
const years = Map.groupBy(issues, (i) => dayjs(i.issue.data.publicationDate).year());
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
---

{
	[...years].map(([year, list]) => (
		<>
			<h3 class="mt-6 text-[15px] leading-5 font-semibold">{year}</h3>
			<ul class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-6 pt-4">
				{list.map(({ issue, href, articles }) => (
					<li>
						<a href={href} class="group block hover:no-underline">
							<Image src={issue.data.cover} alt={`Front page of The Boxing Blade, ${fullDate(issue.data.publicationDate)}`} width={400} class="block h-auto w-full border border-ink" />
							<p class="mt-3 mb-0.5 text-[13px] text-muted">
								Volume {issue.data.volume}, number {issue.data.number}
							</p>
							<p class="font-serif text-xl leading-6.5 font-semibold group-hover:underline">{fullDate(issue.data.publicationDate)}</p>
							<p class="mt-1 text-sm underline decoration-gold decoration-2 underline-offset-4">Read {plural(articles.length, "article")}</p>
						</a>
					</li>
				))}
			</ul>
		</>
	))
}
