---
import TitleTags from "./TitleTags.astro";
import dayjs from "dayjs";
import { group } from "d3-array";
import { slugify } from "../utils";
import type { FeaturedBoutPreview } from "../utils";

interface Props {
	featuredBoutPreviews: FeaturedBoutPreview[];
}

const { featuredBoutPreviews } = Astro.props;
---

<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
	{
		featuredBoutPreviews.map((featuredBout) => (
			<li class="group flex flex-col overflow-hidden rounded border border-neutral-700 bg-neutral-800">
				<a href={`${Astro.url.origin}/articles/${featuredBout.bout.date}-${slugify(featuredBout.name)}/`}>
					<img
						class="h-auto w-full"
						src={`${Astro.url.origin}/${featuredBout.thumbnail}`}
						alt={`${featuredBout.name} thumbnail`}
						width="1280"
						height="720"
						loading="lazy"
					/>
					<div class="px-3 pt-1 pb-3">
						<p class="mb-1.5 text-xs font-medium text-neutral-400">
							<time datetime={featuredBout.bout.date}>{dayjs(featuredBout.bout.date).format("D MMMM YYYY")}</time>
						</p>
						<p class="mb-1.5 h-8 text-sm/4 font-semibold group-hover:underline">
							{featuredBout.name.split(" v ").map((boxer, i) => (
								<span class="block">{i === 0 ? `${boxer} v` : `${boxer}`}</span>
							))}
						</p>
						{[...group(featuredBout.bout.titles, (t) => t.weight.class)].map(([weightClass, titles]) => (
							<div>
								<p class="mb-1 text-xs font-medium text-neutral-400">{weightClass}</p>
								<ul class="flex h-11 flex-wrap items-end">
									<TitleTags titles={titles} includeLinks={false} />
								</ul>
							</div>
						))}
					</div>
				</a>
			</li>
		))
	}
</ul>
