---
import BoxerName from "./BoxerName.astro";
import TitleTags from "./TitleTags.astro";
import dayjs from "dayjs";
import { slugify } from "../utils";
import type { Bout } from "../types";

interface Props {
	bout: Bout;
	dateFormat: string;
	includeWeightClass: boolean;
	useShortName: boolean;
}

const { bout, dateFormat, includeWeightClass, useShortName } = Astro.props;
---

<p class="mb-1.5 text-right text-xs font-medium text-neutral-400">
	<time datetime={bout.date}>
		{dayjs(bout.date).format(dateFormat)}
	</time>
</p>

<p class="mb-1.5 text-sm/4">
	<span class="inline-block"><BoxerName boxer={bout.boxers.boxerA} useShortName={useShortName} useTwoLines={false} /></span> v <br />
	<span class="inline-block"><BoxerName boxer={bout.boxers.boxerB} useShortName={useShortName} useTwoLines={false} /></span>
</p>

{
	includeWeightClass && (
		<p class="mb-1 text-xs font-medium">
			<a class="text-neutral-400 hover:underline" href={`${Astro.url.origin}/${slugify(bout.weight.class)}/`}>
				{bout.weight.class}
				<br />
				{bout.weight.lb + " lb"}
			</a>
		</p>
	)
}

<ul class="flex h-11 flex-wrap items-end">
	<TitleTags titles={bout.titles} includeLinks={true} />
</ul>
