---
import { slugify, orgColours } from "../utils";
import type { Title } from "../types";

interface Props {
	titles: Title[];
	includeLinks: boolean;
}

const { titles, includeLinks } = Astro.props;
---

{
	titles.map((title) => (
		<li class={`mt-1 mr-1 w-max rounded px-2 py-0.5 text-xs font-semibold ${orgColours[title.org.name.abbreviation].text} ${orgColours[title.org.name.abbreviation].bg}`}>
			{includeLinks ? (
				<a class="hover:underline" href={`${Astro.url.origin}/${slugify(title.weight.class)}/${slugify(title.org.name.abbreviation)}/`}>
					{title.org.name.abbreviation}
				</a>
			) : (
				title.org.name.abbreviation
			)}
		</li>
	))
}