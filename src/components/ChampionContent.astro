---
import BoxerName from "./BoxerName.astro";
import dayjs from "dayjs";
import { slugify, orgColours } from "../utils";
import type { Reign } from "../types";

interface Props {
	reign: Reign | null;
	dateFormat: string;
	includeWeightClass: boolean;
	isUndisputed: boolean;
}

const { reign, dateFormat, includeWeightClass, isUndisputed } = Astro.props;

const useUndisputedClass = reign && isUndisputed && ["WBAS", "WBC", "IBF", "WBO"].includes(reign.title.org.name.abbreviation);

// undisputed champions are highlighted in gold
const undisputed = "bg-gold pl-0 text-black";
const orgColour = reign ? orgColours[reign.title.org.name.abbreviation] : null;
---

{
	reign ? (
		<>
			<p class={`mb-1.5 text-right text-xs font-medium ${useUndisputedClass ? undisputed : "text-neutral-400"}`}>
				<time datetime={reign.period.current ? reign.period.begins : reign.period.ends}>
					{dayjs(reign.period.current ? reign.period.begins : reign.period.ends).format(dateFormat)}
				</time>
			</p>
			{reign.period.current ? (
				<p class={`mb-1.5 h-8 truncate text-sm/4 ${useUndisputedClass ? undisputed : ""}`}>
					<BoxerName boxer={reign.champion} useShortName={false} useTwoLines={true} />
				</p>
			) : (
				<p class="mb-1.5 h-8 truncate text-sm/4">
					Vacant <br />
				</p>
			)}
			{includeWeightClass && (
				<p class={`mb-1.5 truncate text-xs font-medium ${useUndisputedClass ? undisputed : "text-neutral-400"}`}>
					<a class="hover:underline" href={`${Astro.url.origin}/${slugify(reign.title.weight.class)}/`}>
						{reign.title.weight.class} <br /> {`${reign.title.weight.lb} lb`}
					</a>
				</p>
			)}
			<p class={`w-fit rounded py-0.5 pr-2 text-xs font-semibold ${useUndisputedClass ? undisputed : `pl-2 ${orgColour?.text} ${orgColour?.bg}`}`}>
				<a class="hover:underline" href={`${Astro.url.origin}/${slugify(reign.title.weight.class)}/${slugify(reign.title.org.name.abbreviation)}/`}>
					{reign.title.org.name.abbreviation}
				</a>
			</p>
		</>
	) : (
		<div class="h-full" />
	)
}
