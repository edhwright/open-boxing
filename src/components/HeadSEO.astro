---
import { getPageIndex } from "../pageIndex";

interface Props {
	title: string;
	description: string;
	img: {
		url: string;
		width: string;
		height: string;
		alt: string;
	} | null;
	// false for a page with no address of its own, e.g. the 404 page
	canonical?: boolean;
}

const { title, description, img, canonical = true } = Astro.props;

// a page's own social image (made in pages/og), else the site's: the logo alone
const slug = Astro.url.pathname.replace(/^\/|\/$/g, "");
const entry = slug ? (await getPageIndex()).find((e) => e.slug === slug) : undefined;
const socialImageURL = img !== null ? img.url : new URL(`/og/${entry ? entry.slug : "default"}.png`, Astro.url);
const socialImageWidth = img !== null ? img.width : "1200";
const socialImageHeight = img !== null ? img.height : "630";
const socialImageAlt = img !== null ? img.alt : entry ? `${entry.name}, on Open Boxing` : "Open Boxing";
---

<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Open Boxing" />
<meta property="og:title" content={title} />
<meta property="og:url" content={Astro.url} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:width" content={socialImageWidth} />
<meta property="og:image:height" content={socialImageHeight} />
<meta property="og:image:alt" content={socialImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={socialImageURL} />
{canonical && <link rel="canonical" href={Astro.url.href} />}
