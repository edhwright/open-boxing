---
interface Props {
	route: [string, string][];
}

const { route } = Astro.props;

const itemClass = "truncate text-sm before:mx-2 before:content-['→'] first:before:hidden";
---

<nav class="my-4">
	<ol class="flex">
		<li class={itemClass}>
			<a class="hover:underline" href={Astro.url.origin}>Home</a>
		</li>
		{
			route.map(([name, url], i) =>
				i === route.length - 1 ? (
					<li class={itemClass}>{name}</li>
				) : (
					// prettier-ignore
					<li class={itemClass}><a class="hover:underline" href={url}>{name}</a></li>
				)
			)
		}
	</ol>
</nav>