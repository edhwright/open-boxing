---
import "./timeline.css";
import { figureHTML, type Model } from "./timeline";

// A page's zoomable timeline (see timeline.ts) as a section: Astro draws the starting view into the page, so it shows
// without JavaScript, and the script below then takes it over to zoom, move through time and show details. Used for
// the weight class and world title pages' reigns and bouts, and a champion's. The model's heading is the section's
// "reigns" heading
interface Props {
	model: Model;
	initial: [string, string];
}

const { model, initial } = Astro.props;
const data = JSON.stringify({ model, initial }).replaceAll("<", "\\u003c");
---

<section aria-labelledby="reigns" class="mb-18" data-reigns-section>
	<script type="application/json" set:html={data} />
	<div data-reigns set:html={figureHTML(model, initial)} />
</section>

<script>
	import { mount } from "./timeline";

	for (const section of document.querySelectorAll<HTMLElement>("[data-reigns-section]")) {
		const { model, initial } = JSON.parse(section.querySelector('script[type="application/json"]')!.textContent!);
		mount(section.querySelector<HTMLElement>("[data-reigns]")!, model, initial);
	}
</script>
